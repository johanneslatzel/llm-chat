<mxfile host="app.diagrams.net" agent="mcp-server export_drawio" version="24.7.17">
  <diagram id="llm-chat-tool-call-loop" name="Tool call loop">
    <mxGraphModel dx="1080" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="810" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pad" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="760" height="765" as="geometry" />
        </mxCell>

        <mxCell id="start" value="sendLoop(iteration)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="410" y="40" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="accumulate content, reasoning,&#10;tool-call deltas, usage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="finish" value="Finish event&#10;(content, toolCalls, reason)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="dec1" value="finishReason?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="420" y="290" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="stopAppend" value="append assistant message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="760" y="315" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stopReturn" value="return to send()" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="415" width="280" height="44" as="geometry" />
        </mxCell>

        <mxCell id="dec2" value="iteration &gt;=&#10;maxToolCallRounds?" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="420" y="470" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="toolAppend" value="append assistant message&#10;with toolCalls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="760" y="500" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="toolExec" value="execute each tool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="760" y="590" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="toolResult" value="append tool result per call" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="760" y="676" width="280" height="56" as="geometry" />
        </mxCell>

        <mxCell id="maxAppend" value="append assistant message&#10;+ user: 'summarize progress'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="410" y="625" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nextIter" value="iteration++" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="410" y="715" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e_start_proc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="start" target="proc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_proc_finish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="proc" target="finish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_finish_dec1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="finish" target="dec1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dec1_stop" value="stop / length" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec1" target="stopAppend">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_stop_return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="stopAppend" target="stopReturn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dec1_dec2" value="tool_calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="dec1" target="dec2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="20" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_dec2_tool" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec2" target="toolAppend">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="0" y="-14" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_tool_exec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="toolAppend" target="toolExec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tool_result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="toolExec" target="toolResult">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dec2_max" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec2" target="maxAppend">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="20" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_max_next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="maxAppend" target="nextIter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tool_next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="toolResult" target="nextIter">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="725" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_next_start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="nextIter" target="start">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="740" />
              <mxPoint x="320" y="62" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
