# LLM Chat - Configuration (example reference)
# Copy to .env and fill in your values.
# Provider credentials and model configuration live in @johannes.latzel/llm-chat-openai.

# --- Chat Service ---
# LLM_CHAT_MAX_TOOL_CALL_ROUNDS=10                # default: 10
# LLM_CHAT_CONTEXT_WINDOW_SIZE_HINT=0             # context window size hint in tokens (0 = unlimited); used by isContextWindowExceeded()
# LLM_CHAT_PARSE_INLINE_TOOL_CALLS=false          # parse explicit <tool_call>...</tool_call> blocks in streamed content
# LLM_CHAT_PARSE_INLINE_REASONING=false           # parse explicit inline reasoning markers in streamed content

# --- Prompts ---
# LLM_CHAT_SYSTEM_PROMPT=                       # inline flat system prompt; wins over the file and directory sources
# LLM_CHAT_SYSTEM_PROMPT_DIR=                     # path to a directory of system prompt files (.md, .txt); read if it exists (never created); each becomes a component under the `general` container
# LLM_CHAT_SYSTEM_PROMPT_FILE=                    # path to a single .md/.txt file used as the flat system prompt; overrides LLM_CHAT_SYSTEM_PROMPT_DIR
# LLM_CHAT_USER_PROMPTS=                          # comma-separated paths to initial user message files

# --- JSON hooks ---
# LLM_CHAT_HOOKS_DIR=                             # path to a directory of .json hook definition files (auto-loaded on init/send)
