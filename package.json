{
    "name": "@johannes.latzel/llm-chat",
    "version": "0.10.0",
    "description": "TypeScript chat agents with typed tool calls, streaming, and hooks for OpenAI-compatible APIs",
    "license": "MIT",
    "sideEffects": false,
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "author": "Johannes B. Latzel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johanneslatzel/llm-chat.git"
    },
    "bugs": {
        "url": "https://github.com/johanneslatzel/llm-chat/issues"
    },
    "homepage": "https://github.com/johanneslatzel/llm-chat#readme",
    "keywords": [
        "llm",
        "chat",
        "agents",
        "openai",
        "openai-compatible",
        "typescript",
        "streaming",
        "tool-calls",
        "hooks"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "verify": "tsc --noEmit && eslint . --max-warnings 0 && npm run check:lines && npm run check:mkdocs && vitest run --coverage",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write src",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "clean:pack": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify && npm run build && npm pack",
        "clean:install": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify",
        "docs": "docker run --rm -it -p 8000:8000 -v $PWD:/docs squidfunk/mkdocs-material",
        "prepare": "husky",
        "prebuild": "rm -rf dist/",
        "prepack": "npm run build",
        "audit": "npm audit --audit-level=high",
        "check:lines": "check-line-limits",
        "check:mkdocs": "check-mkdocs"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "prettier --write",
            "eslint --max-warnings 0 --no-warn-ignored",
            "vitest related --run"
        ]
    },
    "dependencies": {
        "async-mutex": "^0.5.0",
        "openai": "^7.43.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.4.0",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.60.0",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-n": "^18.2.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "prettier": "^3.5.3",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0",
        "@johannes.latzel/check-line-limits": "^1.0.1",
        "@johannes.latzel/check-mkdocs": "^0.1.0"
    }
}
